alias ugz='tar -xzvf'
up() {
    local step=1

    if command -v apt >/dev/null 2>&1; then
        printf '┌──────────────────────────────────────────────────────────────────────────────┐\n'
        printf '│ %-76s │\n' "$step. APT Update & Upgrade"
        printf '└──────────────────────────────────────────────────────────────────────────────┘\n'
        # 若有新添加的旧版 .list 源，在 update 前自动完成现代化
        if apt modernize-sources --assume-no 2>&1 | grep -q 'The following files need modernizing'; then
            sudo apt modernize-sources -y 2>/dev/null
        fi
        # 若开启了 i386 多架构，自动为缺失架构字段的第三方 .sources 源补齐 Architectures: amd64
        if dpkg --print-foreign-architectures 2>/dev/null | grep -q 'i386'; then
            for f in /etc/apt/sources.list.d/*.sources; do
                if [ -f "$f" ] && [ "$f" != "/etc/apt/sources.list.d/ubuntu.sources" ]; then
                    if ! grep -q '^Architectures:' "$f"; then
                        sudo sed -i '/^Suites:/a Architectures: amd64' "$f" 2>/dev/null || true
                    fi
                fi
            done
        fi
        sudo apt update && sudo apt upgrade -y && sudo apt autoremove -y && sudo apt autoclean
        step=$((step + 1))
        echo ""
    fi

    if command -v deb-get >/dev/null 2>&1; then
        printf '┌──────────────────────────────────────────────────────────────────────────────┐\n'
        printf '│ %-76s │\n' "$step. deb-get Update & Upgrade"
        printf '└──────────────────────────────────────────────────────────────────────────────┘\n'
        sudo env DISABLE_APT=y deb-get update && sudo env DISABLE_APT=y deb-get upgrade --dg-only
        step=$((step + 1))
        echo ""
    fi

    if command -v snap >/dev/null 2>&1; then
        printf '┌──────────────────────────────────────────────────────────────────────────────┐\n'
        printf '│ %-76s │\n' "$step. Snap Refresh"
        printf '└──────────────────────────────────────────────────────────────────────────────┘\n'
        sudo snap refresh
        step=$((step + 1))
        echo ""
    fi

    if command -v flatpak >/dev/null 2>&1; then
        printf '┌──────────────────────────────────────────────────────────────────────────────┐\n'
        printf '│ %-76s │\n' "$step. Flatpak Update"
        printf '└──────────────────────────────────────────────────────────────────────────────┘\n'
        flatpak update -y
        step=$((step + 1))
        echo ""
    fi

    if command -v mise >/dev/null 2>&1; then
        printf '┌──────────────────────────────────────────────────────────────────────────────┐\n'
        printf '│ %-76s │\n' "$step. Mise Upgrade"
        printf '└──────────────────────────────────────────────────────────────────────────────┘\n'
        mise up -q
        step=$((step + 1))
        echo ""
    fi
}

